{
  "name": "zeego-dispatch-engine",
  "version": "1.0.0",
  "description": "Production-scale Real-Time Last-Mile Dispatch Engine for Zeego Delivery (Qatar)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run start --workspace=server\" \"npm run start --workspace=client\"",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
